# -------------------------
# Single-server compose env
# -------------------------

# Ports exposed on host
FRONTEND_PORT=80
BACKEND_PORT=3000

# PostgreSQL container credentials (also used to build DATABASE_URL inside compose)
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=alalouche

# Backend required in production
AUTH_TOKEN_SECRET=replace_with_a_unique_random_secret_at_least_32_chars_long
CORS_ALLOWED_ORIGINS=https://orders.example.com

# Redis helper layer (internal compose service by default)
# Leave as-is for the bundled internal Redis service unless you use a managed Redis instance.
REDIS_URL=redis://redis:6379

# Marketing email delivery (Admin bulk sends via Resend)
# none|resend
MARKETING_EMAIL_PROVIDER=none
MARKETING_EMAIL_FROM=
# Backward compatibility for marketing only during transition
EMAIL_PROVIDER=none
EMAIL_FROM=
RESEND_API_KEY=

# Transactional email delivery (orders/reservations/status emails via SMTP)
# none|smtp
TRANSACTIONAL_EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=

# Optional backend compatibility / tenant settings
# Keep legacy header-based admin auth disabled in production.
ALLOW_LEGACY_ADMIN_HEADERS=false
# ADMIN_TOKEN is only used when ALLOW_LEGACY_ADMIN_HEADERS=true in non-production. Leave blank in production.
ADMIN_TOKEN=
# DEFAULT_RESTAURANT_ID is development-only and must stay blank in production.
DEFAULT_RESTAURANT_ID=
TENANT_BASE_DOMAIN=

# S3-compatible object storage (required for admin menu image upload endpoint)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional object storage tuning
# Example for DO Spaces CDN/public base URL:
# S3_PUBLIC_BASE_URL=https://my-space.nyc3.cdn.digitaloceanspaces.com
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_MAX_BYTES=5242880
S3_OBJECT_ACL=public-read
S3_CACHE_CONTROL=public, max-age=31536000, immutable

# Migration behavior on backend container startup
# true|false
RUN_DB_MIGRATIONS=true

# Frontend build-time API base URL (must be publicly reachable from browsers)
# Example with same server public IP + backend port:
# VITE_API_BASE_URL=https://api.orders.example.com
VITE_API_BASE_URL=https://api.orders.example.com
