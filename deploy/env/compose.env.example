# -------------------------
# Single-server compose env
# -------------------------

# Ports exposed on host
FRONTEND_PORT=80
BACKEND_PORT=3000

# PostgreSQL container credentials (also used to build DATABASE_URL inside compose)
POSTGRES_USER=kobradb
POSTGRES_PASSWORD=MobraKurat1912
POSTGRES_DB=kobradb

# Backend required in production (openssl rand -base64 48 ile rastgele olustur)
AUTH_TOKEN_SECRET=JiySWsvPKyb5yylrVjCM0ZkWqwhRB4skq7Vu74VxuQx9ZblvZ1kE8zLqQomUdA4L

# Backend email provider
# none|resend
EMAIL_PROVIDER=resend
# Required only when EMAIL_PROVIDER=resend
RESEND_API_KEY=re_cKfzss4Y_DuNsnSZ4yaYQpHh6TXU5opjh
EMAIL_FROM=info@alalouche.ch

# Optional backend compatibility / tenant settings
ADMIN_TOKEN=
DEFAULT_RESTAURANT_ID=demo-restaurant
TENANT_BASE_DOMAIN=

# Migration behavior on backend container startup
# true|false
RUN_DB_MIGRATIONS=true

# Frontend build-time API base URL (must be publicly reachable from browser)
# Example with same server public IP + backend port:
# VITE_API_BASE_URL=http://203.0.113.10:3000
VITE_API_BASE_URL=http://localhost:3000
