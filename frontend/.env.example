# Single frontend/Sunmi API base URL.
# Dev can use localhost. Production/static builds must set this to the public backend origin and it cannot be localhost.
# Example production value: https://api.orders.example.com
VITE_API_BASE_URL=http://localhost:3000

# Temporary admin token used by admin pairing endpoints (dev only; production uses bearer auth)
VITE_ADMIN_TOKEN=dev-admin

# Optional debug logs for migrated pairing/receiver slice
VITE_DEBUG_PAIRING=false
