generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeviceLifecycleStatus {
  code_created
  request_pending
  request_confirmed
  device_active
  device_revoked
  device_expired
}

enum OrderStatus {
  new
  accepted
  ready
  completed
  cancelled
}

enum ReservationStatus {
  pending
  confirmed
  cancelled
}

model Restaurant {
  id               String                 @id @default(cuid())
  name             String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  devices          Device[]
  orders           Order[]
  reservations     Reservation[]
  pairingCodes     DevicePairingCode[]
  pairingRequests  DevicePairingRequest[]
  adminUsers       AdminUser[]
  customers        Customer[]
}

model AdminUser {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  username      String     @unique
  passwordHash  String
  displayName   String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Customer {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  fullName      String
  email         String
  phone         String?
  passwordHash  String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([restaurantId, email])
}

model DevicePairingCode {
  id            String                @id @default(cuid())
  code          String                @unique
  status        DeviceLifecycleStatus @default(code_created)
  restaurantId  String
  restaurant    Restaurant            @relation(fields: [restaurantId], references: [id])
  expiresAt     DateTime
  createdBy     String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  requests      DevicePairingRequest[]
}

model DevicePairingRequest {
  id                String                @id @default(cuid())
  pairingCodeId     String
  pairingCode       DevicePairingCode     @relation(fields: [pairingCodeId], references: [id])
  restaurantId      String
  restaurant        Restaurant            @relation(fields: [restaurantId], references: [id])
  status            DeviceLifecycleStatus @default(request_pending)
  deviceName        String?
  deviceModel       String?
  platform          String?
  appVersion        String?
  installId         String?
  confirmedAt       DateTime?
  tokenIssuedAt     DateTime?
  plainTokenPreview String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  device            Device?
}

model Device {
  id               String                @id @default(cuid())
  restaurantId     String
  restaurant       Restaurant            @relation(fields: [restaurantId], references: [id])
  pairingRequestId String?               @unique
  pairingRequest   DevicePairingRequest? @relation(fields: [pairingRequestId], references: [id])
  status           DeviceLifecycleStatus @default(device_active)
  deviceName       String
  deviceModel      String?
  platform         String?
  appVersion       String?
  installId        String?
  tokenHash        String?               @unique
  lastSeenAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model Order {
  id            String      @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id])
  orderNumber   String
  customerName  String
  customerEmail String?
  status        OrderStatus @default(new)
  prepMinutes   Int?
  totalAmount   Decimal     @default(0) @db.Decimal(10, 2)
  payload       Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Reservation {
  id              String            @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id])
  customerName    String
  customerEmail   String?
  guestCount      Int
  reservationDate DateTime
  status          ReservationStatus @default(pending)
  notes           String?
  statusUpdatedAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}