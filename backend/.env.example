# App
PORT=3000
NODE_ENV=development
# Dev-only defaults below. Production must use a unique secret (32+ chars), explicit public CORS origins, no default restaurant fallback, and a real restaurant primary domain.
AUTH_TOKEN_SECRET=dev-auth-token-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173
ALLOW_LEGACY_ADMIN_HEADERS=true
ADMIN_TOKEN=dev-admin
DEFAULT_RESTAURANT_ID=alalouche
TENANT_BASE_DOMAIN=
RESTAURANT_PRIMARY_DOMAIN=
REDIS_URL=redis://localhost:6379

# Database (matches backend/docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=alalouche
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alalouche?schema=public

# Seed options
SEED_SAMPLE_ORDERS=true

# Marketing email delivery (Admin bulk sends via Resend)
# MARKETING_EMAIL_PROVIDER supports: none | resend
MARKETING_EMAIL_PROVIDER=none
MARKETING_EMAIL_FROM=
# Backward compatibility for marketing only: if MARKETING_EMAIL_PROVIDER is unset, marketing falls back to EMAIL_PROVIDER/EMAIL_FROM.
EMAIL_PROVIDER=none
EMAIL_FROM=
RESEND_API_KEY=

# Transactional email delivery (orders/reservations/status emails via SMTP)
# TRANSACTIONAL_EMAIL_PROVIDER supports: none | smtp
TRANSACTIONAL_EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=

# S3-compatible object storage (admin menu image uploads)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional, defaults shown below
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_MAX_BYTES=5242880
S3_OBJECT_ACL=public-read
S3_CACHE_CONTROL=public, max-age=31536000, immutable
