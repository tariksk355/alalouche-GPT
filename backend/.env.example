# App
PORT=3000
NODE_ENV=development
# Dev-only defaults below. Production must use a unique secret (32+ chars), explicit CORS origins, and no default restaurant fallback.
AUTH_TOKEN_SECRET=dev-auth-token-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173
ADMIN_TOKEN=dev-admin
DEFAULT_RESTAURANT_ID=demo-restaurant
TENANT_BASE_DOMAIN=

# Database (matches backend/docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=alalouche
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alalouche?schema=public

# Seed options
SEED_SAMPLE_ORDERS=true

# Email delivery (backend-only)
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=

# S3-compatible object storage (admin menu image uploads)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional, defaults shown below
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_MAX_BYTES=5242880
S3_OBJECT_ACL=public-read
S3_CACHE_CONTROL=public, max-age=31536000, immutable
